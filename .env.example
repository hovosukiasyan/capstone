# PostgreSQL connection for ILCS loader (scripts/ilcs_load_to_postgres.py)
# Copy to .env and fill in your values. Install python-dotenv so .env is loaded.

# Option 1: single URL (db name: capstone)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/capstone

# Option 2: separate variables (defaults: host=localhost, port=5432, user=postgres, db=capstone)
# POSTGRES_PASSWORD=YOUR_PASSWORD
# POSTGRES_DB=capstone
