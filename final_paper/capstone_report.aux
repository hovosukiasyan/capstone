\citation{optuna2019}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Feature importance comparison across all five models (grouped bars). \textbf  {Capture from} \texttt  {/models/importance} on \texttt  {https://armenia-poverty.vercel.app} (same view as Section~6.4---you may reuse one screenshot for both). See Appendix~\ref {app:figure-guide}.}}{14}{figure.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Bayesian Hyperparameter Optimization}{14}{subsection.6.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Bayesian optimization results. GBM benefits most from tuning. The CV--Test gap (0.43 vs.\ 0.36) reflects mild overfitting to training folds.}}{14}{table.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Optuna optimization history: CV R\textsuperscript  {2} across trials for GBM. \textbf  {Not on the web app}---export from the Bayesian optimization notebook (\texttt  {notebooks/ilcs\_ml\_bayesian\_optimized.ipynb}). See Appendix~\ref {app:figure-guide}.}}{15}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Predicted vs.\ actual household income for the tuned GBM (log--log recommended). \textbf  {Not on the web app}---export from the same notebook as the Optuna run. See Appendix~\ref {app:figure-guide}.}}{16}{figure.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Time-Series Analysis --- Classical Models}{16}{subsection.6.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Classical time-series model results across frequencies. Monthly/daily $R^2$ appears inflated because values are forward-filled from annual estimates; yearly results are the honest benchmark.}}{17}{table.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Time-Series Analysis --- Neural Network Models}{17}{subsection.6.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Neural network time-series results. On yearly data (the honest benchmark), all NNs underperform classical Lag-1 ($R^2=0.728$) due to insufficient training samples ($\sim $7 data points per region). The Transformer shows the most promise at yearly granularity. Monthly-frequency rows reuse the filled annual signal, so strong scores there are mechanical and must not be read as richer survey evidence (see~\S  \ref {sec:model-results}).}}{18}{table.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Summary of $R^2$ for poverty rate across frequencies and model families. \textbf  {Primary web source:} \texttt  {/models/forecasting} on \texttt  {https://armenia-poverty.vercel.app}---capture the \textit  {Classical TS (ARIMA)} tab and the \textit  {Advanced NNs} tab (stack or composite into one image, or paste side-by-side). A custom heatmap is optional if it matches the same underlying metrics as Tables~5.4--5.5. Appendix~\ref {app:figure-guide}.}}{19}{figure.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}2022 Forecast Validation (Primary Evidence)}{19}{subsection.6.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces 2022 holdout validation summary (poverty\_rate). Lag-1 wins regionally; the Ensemble achieves near-zero national error because directional biases cancel under population weighting.}}{20}{table.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Per-region 2022 absolute errors (pp) by model. Bold = best model per row. Aragatsotn and Vayots Dzor are the hardest marzes due to anomalous year-over-year swings.}}{20}{table.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Actual vs.\ predicted 2022 poverty rate by marz (holdout trained on 2016--2021). \textbf  {Capture from} \texttt  {/models/validation} on \texttt  {https://armenia-poverty.vercel.app}---use the bar chart and model pills (Lag-1 / Ridge AR / Ensemble) as needed. Same numbers as \texttt  {forecast\_validation\_2022.csv}. Appendix~\ref {app:figure-guide}.}}{21}{figure.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Rolling validation: regional MAE (poverty\_rate, 11 marzes). Ridge's 2021 spike is caused by Aragatsotn's anomalous 2019 value (51.4\%) entering the lag-2 feature.}}{21}{table.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Rolling validation: regional MAE for Lag-1 vs.\ Ridge AR (poverty rate). \textbf  {Capture from} \texttt  {/models/validation} (rolling section). Same data as \texttt  {forecast\_rolling\_validation.csv}. Appendix~\ref {app:figure-guide}.}}{22}{figure.7}\protected@file@percent }
